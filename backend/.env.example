# ─── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# ─── ElevenLabs ────────────────────────────────────────────
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# ─── Deepgram ──────────────────────────────────────────────
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# ─── MySQL ──────────────────────────────────────────────────
# Supply your own database URL through the runtime environment; this is only a safe placeholder.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/DB_NAME

# ─── Server / prototype admin access ───────────────────────
PORT=8000
# Required to access every admin API route. Generate a long random value.
ADMIN_API_KEY=replace-with-a-long-random-admin-key

# Public browser origins, exact scheme/host/port entries, comma-separated.
# Add your deployed frontend origin(s); do not use a wildcard.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3010,http://127.0.0.1:3010
MAX_CALL_DURATION_SECONDS=900
MAX_CONCURRENT_SESSIONS_PER_IP=2
MAX_AUDIO_FRAME_BYTES=65536
MAX_AUDIO_QUEUE_FRAMES=50
MAX_TRANSCRIPT_QUEUE_ITEMS=100
MAX_TRANSCRIPT_ENTRIES=500

# Comma-separated code or code:Deepgram-language pairs explicitly tested by
# the operator. Default effective languages are English only. Do not add a
# language until STT AND ElevenLabs voice output are tested end-to-end.
DEEPGRAM_SUPPORTED_LANGUAGES=en:en-US
TESTED_TTS_LANGUAGES=en
